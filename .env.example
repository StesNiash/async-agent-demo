# mock (default) or openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=mock

# DeepSeek example:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...
#
# OpenAI-compatible endpoint:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
